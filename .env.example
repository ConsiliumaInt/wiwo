# Required for real cloud browser and sandbox execution.
SOLARI_API_KEY=slr_live_replace_me

# Set this when reverse-proxying WIWO under a path such as consiliuma.co.uk/wiwo.
NEXT_PUBLIC_BASE_PATH=/wiwo

# LLM provider: openai (default) or deepseek.
LLM_PROVIDER=deepseek

# Required for natural-language workflow planning and source repair when using OpenAI.
OPENAI_API_KEY=sk-replace_me
OPENAI_MODEL=gpt-5-mini

# Required when LLM_PROVIDER=deepseek. DeepSeek exposes an OpenAI-compatible Responses API.
DEEPSEEK_API_KEY=sk-replace_me
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional. Defaults to 12 browser decisions and a 20 minute run deadline.
WIWO_MAX_BROWSER_STEPS=12
WIWO_RUN_TIMEOUT_MS=1200000
